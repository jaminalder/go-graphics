# Store as /etc/art/operator.env on the host, owned by root, mode 0600.
# One production environment: use http://SERVER_IP before configuring DNS.
# Set both ART_DOMAIN and ART_ORIGIN to that same origin.
ART_DOMAIN=https://singularseed.art
ART_ORIGIN=https://singularseed.art
ART_BIND=0.0.0.0
ART_BIND6=[::]
ART_HTTP_PORT=80
ART_HTTPS_PORT=443
ART_PROXY_NET=172.30.80
ART_LOG_LEVEL=info
# Verify IPv4 and IPv6 HTTPS/filtering before publishing A/AAAA records.
