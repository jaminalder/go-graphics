# Copy to /etc/art/storage.env; no credentials in this file.
ART_S3_ENDPOINT=https://nbg1.your-objectstorage.com
ART_S3_REGION=nbg1
ART_S3_BUCKET=replace-with-private-bucket
ART_S3_PREFIX=singular-seed
ART_S3_LOCAL=false
ART_SECRETS_DIR=/etc/art/secrets
ART_DATABASE_NETWORK=singular-seed-data_default
# Production defaults; local helpers explicitly choose local-capacity instead.
ART_LIMITS_PROFILE=production
# Optional bounded JSON overrides, applied to all web/renderer services:
# ART_LIMITS_JSON={"outstanding_jobs":24}
