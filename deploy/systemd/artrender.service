[Unit]
Description=Art Forms isolated renderer supervisor
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3
[Service]
User=artrender
Group=art-render
ExecStart=/opt/art/current/artrender
Environment=ART_SOCKET=/run/artrender/renderer.sock
Environment=GOMAXPROCS=2
RuntimeDirectory=artrender
RuntimeDirectoryMode=0750
UMask=0007
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
OOMPolicy=kill
MemoryMax=2G
MemorySwapMax=0
CPUQuota=150%
TasksMax=64
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
[Install]
WantedBy=multi-user.target
